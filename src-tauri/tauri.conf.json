{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IranNANternet",
  "version": "0.1.1",
  "identifier": "net.nanternet.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IranNANternet",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Regional-aware uptime and server health monitoring",
    "longDescription": "IranNANternet watches websites, SSH hosts, Docker containers and certificate expiry, and tells apart a real outage from a regional network isolation.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGQkY2OTcwNkQ4RjI0QzQKUldURUpJOXRjR20vMzAwMkp2b3UwTDBjb3BXMnFCK0FNOGVmYWRyeEd5aGpyanptUXgvQnBCL3UK",
      "endpoints": [
        "https://github.com/drstreet/nanternet/releases/latest/download/latest.json"
      ]
    }
  }
}
